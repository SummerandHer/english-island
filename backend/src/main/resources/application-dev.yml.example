# 复制为 application-dev.yml 并填写真实密钥（勿提交 Git）
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/island?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: island
    password: island123

island:
  jwt:
    secret: your-local-dev-secret-at-least-32-characters-long
  ai:
    enabled: true
    api-key: sk-your-key-here
